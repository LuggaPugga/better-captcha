{
	"name": "@better-captcha/react",
	"description": "React wrappers for CAPTCHA providers that share the same lifecycle, render flow, and control handle so you can swap vendors easily.",
	"version": "0.7.0",
	"author": "LuggaPugga",
	"repository": {
		"type": "git",
		"url": "https://github.com/LuggaPugga/better-captcha.git"
	},
	"homepage": "https://better-captcha.dev",
	"license": "MIT",
	"keywords": [
		"captcha",
		"react",
		"recaptcha",
		"hcaptcha",
		"turnstile",
		"friendly-captcha"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"type": "module",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"dev": "tsdown --watch",
		"test:playwright": "playwright test"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./base-captcha": {
			"types": "./dist/base-captcha.d.ts",
			"default": "./dist/base-captcha.js"
		},
		"./provider": {
			"types": "./dist/provider/index.d.ts",
			"default": "./dist/provider/index.js"
		},
		"./provider/*": {
			"types": "./dist/provider/*/index.d.ts",
			"default": "./dist/provider/*/index.js"
		},
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			"base-captcha": [
				"dist/base-captcha.d.ts"
			],
			"provider": [
				"dist/provider/index.d.ts"
			],
			"provider/*": [
				"dist/provider/*/index.d.ts"
			]
		}
	},
	"peerDependencies": {
		"typescript": "^5.0.0",
		"react": "^18 || ^19"
	},
	"dependencies": {
		"@better-captcha/core": "workspace:^"
	},
	"devDependencies": {
		"@better-captcha/tests": "workspace:*",
		"@playwright/test": "^1.62.1",
		"@types/bun": "1.3.14",
		"@types/node": "26.2.0",
		"@types/react": "^19.2.18",
		"playwright": "^1.62.1",
		"tsdown": "^0.22.14",
		"unplugin": "^3.3.0"
	}
}
